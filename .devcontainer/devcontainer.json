{
  "name": "Ward",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",

  // รหัสผ่านของหอผู้ป่วย — ตั้งไว้ที่ https://github.com/settings/codespaces (Codespaces secrets)
  // แล้วทุก codespace ของ repo นี้จะรับค่าไปเอง ไม่ต้องพิมพ์คำสั่งใด ๆ
  // ถ้าไม่ได้ตั้ง ระบบจะใช้รหัสเริ่มต้น "ward1234" ซึ่งห้ามใช้กับข้อมูลผู้ป่วยจริง
  "secrets": {
    "WARD_PASSCODE": {
      "description": "รหัสผ่านร่วมของหอผู้ป่วย ใช้ตอน login เข้าเว็บ Ward"
    }
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Ward",
      "onAutoForward": "openBrowser"
    }
  },

  // ครั้งแรกที่สร้าง codespace: ใส่ข้อมูลตัวอย่างให้ลองใช้ทันที
  "postCreateCommand": "node seed.js",

  // ทุกครั้งที่ codespace เริ่มทำงาน (รวมถึงตอนปลุกจากการหลับ): สตาร์ทเซิร์ฟเวอร์แบบเบื้องหลัง
  // ต้องเป็น postStart ไม่ใช่ postAttach เพราะผู้ใช้ส่วนใหญ่เปิดแค่ลิงก์เว็บ ไม่ได้เปิดหน้า VS Code
  // ถ้าสตาร์ทเฉพาะตอน attach ลิงก์ที่เซฟไว้จะเปิดไม่ขึ้นและ Safari จะขึ้นเป็นไฟล์ว่าง 0 KB
  "postStartCommand": "bash .devcontainer/start-ward.sh",

  // ตอนเปิดหน้า VS Code: ดึงโค้ดล่าสุด แล้วสตาร์ทใหม่ถ้าเซิร์ฟเวอร์ยังไม่ขึ้น
  // ถ้าดึงไม่ได้ (ไม่มีเน็ต หรือมีไฟล์ค้างแก้อยู่) ก็ข้ามไป ไม่ให้แอปไม่ขึ้น
  "postAttachCommand": "git pull --ff-only || echo 'ดึงโค้ดล่าสุดไม่ได้ — ใช้โค้ดที่มีอยู่ต่อ'; bash .devcontainer/start-ward.sh",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
