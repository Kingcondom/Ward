{
  "name": "Ward",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",

  // รหัสผ่านของหอผู้ป่วย — ตั้งไว้ที่ https://github.com/settings/codespaces (Codespaces secrets)
  // แล้วทุก codespace ของ repo นี้จะรับค่าไปเอง ไม่ต้องพิมพ์คำสั่งใด ๆ
  // ถ้าไม่ได้ตั้ง ระบบจะใช้รหัสเริ่มต้น "ward1234" ซึ่งห้ามใช้กับข้อมูลผู้ป่วยจริง
  "secrets": {
    "WARD_PASSCODE": {
      "description": "รหัสผ่านร่วมของหอผู้ป่วย ใช้ตอน login เข้าเว็บ Ward"
    }
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Ward",
      "onAutoForward": "openBrowser"
    }
  },

  // ครั้งแรกที่สร้าง codespace: ใส่ข้อมูลตัวอย่างให้ลองใช้ทันที
  "postCreateCommand": "node seed.js",

  // ทุกครั้งที่เปิด codespace: ดึงโค้ดล่าสุดแล้วสตาร์ทเซิร์ฟเวอร์ หน้าเว็บจะเด้งขึ้นเอง
  // ถ้าดึงไม่ได้ (ไม่มีเน็ต หรือมีไฟล์ค้างแก้อยู่) ก็ข้ามไป ไม่ให้แอปไม่ขึ้น
  "postAttachCommand": "git pull --ff-only || echo 'ดึงโค้ดล่าสุดไม่ได้ — ใช้โค้ดที่มีอยู่ต่อ'; npm start",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
