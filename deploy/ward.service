# systemd unit สำหรับรัน Ward ค้างไว้ตลอดบนคอมพิวเตอร์ Linux ในวอร์ด
# ติดตั้ง: sudo bash deploy/install-linux.sh
[Unit]
Description=Ward — ระบบเก็บข้อมูลผู้ป่วยในหอผู้ป่วย
Documentation=https://github.com/Kingcondom/Ward
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__WARD_DIR__
ExecStart=__NODE__ server.js
# รหัสผ่านเก็บในไฟล์แยก (อ่านได้เฉพาะ root) ไม่ใส่ไว้ในไฟล์นี้เพราะ systemctl show จะอ่านเห็น
EnvironmentFile=/etc/ward.env
Restart=always
RestartSec=3
# ถ้าแอปล้มซ้ำ ๆ ก็ยังพยายามใหม่เรื่อย ๆ ไม่ยอมแพ้
StartLimitIntervalSec=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ward

[Install]
WantedBy=multi-user.target
